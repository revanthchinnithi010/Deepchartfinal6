# ─── Frontend API ─────────────────────────────────────────────────────────────
# Railway frontend must point to the public URL of the separate API service.
# Example: https://your-api-service.up.railway.app
VITE_API_BASE_URL=

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (auto-provisioned on Replit)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-secret

# ─── API CORS ─────────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://workspacetrading-journal-production-ef57.up.railway.app

# ─── Market Data Providers ───────────────────────────────────────────────────
# Finnhub (Forex + Indices): https://finnhub.io — free tier available
FINNHUB_API_KEY=

# ─── Telegram Alerts (optional) ──────────────────────────────────────────────
# Create a bot via @BotFather, then get your Chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
