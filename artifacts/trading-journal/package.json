{
  "name": "@workspace/trading-journal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bash ../../scripts/ensure-install.sh",
    "dev": "pnpm exec vite --config vite.config.ts --host 0.0.0.0",
    "build": "node ./scripts/fix-remove-splash.mjs && node ./scripts/fix-trendline.mjs && node ./scripts/fix-mobile-drawing-button.mjs && node ./scripts/fix-mobile-tools-spacing.mjs && node ./scripts/fix-pinch-zoom.mjs && node ./scripts/fix-native-pinch.mjs && node ./scripts/fix-alert-drawing-selector.mjs && node ./scripts/fix-add-trade-ui.mjs && node -e \"const fs=require('fs');const p='src/components/charts/CustomChart.tsx';let s=fs.readFileSync(p,'utf8');s=s.replace(/MIN_FUTURE_BARS\\s*=\\s*50/,'MIN_FUTURE_BARS = 8');fs.writeFileSync(p,s);\" && pnpm exec vite build --config vite.config.ts && node ./scripts/mirror-dist-public.mjs",
    "serve": "pnpm exec vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.2.4",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.1.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.1",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.3",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/vite": "^4.1.7",
    "@tanstack/react-query": "catalog:",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.8",
    "@vitejs/plugin-react": "^4.4.1",
    "@workspace/api-client-react": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^12.4.7",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.511.0",
    "motion": "^12.4.0",
    "react-day-picker": "^9.7.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.5.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.1",
    "sonner": "^2.0.2",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.7",
    "wouter": "^3.10.0",
    "zustand": "^5.0.3"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "html2canvas": "^1.4.1",
    "lightweight-charts": "^5.0.8",
    "wouter": "^3.10.0",
    "zustand": "^5.0.3"
  }
}
